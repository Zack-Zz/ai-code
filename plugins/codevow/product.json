{
  "schema_version": 2,
  "product_id": "codevow",
  "display_name": "CodeVow",
  "version": "1.0.7",
  "repository": "https://github.com/Zack-Zz/ai-code",
  "license": "MIT",
  "hosts": [
    "claude",
    "codex",
    "zcode",
    "dsh"
  ],
  "host_listings": {
    "claude": {},
    "zcode": {
      "icon_path": "assets/codevow.png",
      "icon_url": "https://raw.githubusercontent.com/Zack-Zz/ai-code/91dec3a64731f8de2fb68e49bce9f4228289bbbd/plugins/ai-code-workflow/assets/codevow.png"
    }
  },
  "profiles": [
    "collaborative",
    "continuous"
  ],
  "generated_agents": [
    {
      "host": "claude",
      "template": "adapters/claude/agents/workflow-reviewer.md",
      "body": "skills/review/references/reviewer-contract.md",
      "target": "agents/workflow-reviewer.md"
    },
    {
      "host": "zcode",
      "template": "adapters/zcode/agents/workflow-reviewer.md",
      "body": "skills/review/references/reviewer-contract.md",
      "target": "agents/workflow-reviewer.md"
    }
  ],
  "core_skills": [
    "workflow",
    "tdd",
    "debugging",
    "review",
    "verification"
  ],
  "shared_skills": [
    "review-results"
  ],
  "resources": [
    {
      "source": "policies",
      "target": "policies",
      "include": [
        "collaborative.json",
        "continuous.json"
      ]
    },
    {
      "source": "schemas",
      "target": "schemas",
      "include": [
        "product.schema.json",
        "policy.schema.json",
        "task.schema.json",
        "evidence.schema.json"
      ]
    },
    {
      "source": "templates",
      "target": "templates",
      "include": [
        "task.json",
        "evidence.json"
      ]
    },
    {
      "source": "skills/review/references",
      "target": "skills/review/references",
      "include": [
        "reviewer-contract.md"
      ]
    },
    {
      "source": "scripts/workflow_tool.py",
      "target": "tools/workflow_tool.py",
      "include": []
    },
    {
      "source": "scripts/workflow",
      "target": "tools/workflow",
      "include": [
        "__init__.py",
        "product.py",
        "policy.py",
        "state.py",
        "build.py",
        "package_check.py",
        "owned_files.py",
        "cli.py",
        "io.py"
      ]
    },
    {
      "source": "LICENSE",
      "target": "LICENSE",
      "include": []
    },
    {
      "source": "NOTICE",
      "target": "NOTICE",
      "include": []
    },
    {
      "source": "LICENSES",
      "target": "LICENSES",
      "include": [
        "backend-engineering-lite.txt"
      ]
    },
    {
      "source": "assets/codevow.svg",
      "target": "assets/codevow.svg",
      "include": []
    },
    {
      "source": "release/README.md",
      "target": "README.md",
      "include": []
    },
    {
      "source": "release/README_CN.md",
      "target": "README_CN.md",
      "include": []
    },
    {
      "source": "assets/codevow.png",
      "target": "assets/codevow.png",
      "include": []
    },
    {
      "source": "skills/workflow/references",
      "target": "skills/workflow/references",
      "include": [
        "execution.md"
      ]
    }
  ],
  "publisher": {
    "name": "Zack-Zz",
    "url": "https://github.com/Zack-Zz"
  },
  "host_resources": {
    "dsh": [
      {
        "source": "adapters/dsh/cordis.patch.yml",
        "target": "cordis.patch.yml",
        "include": []
      },
      {
        "source": "adapters/dsh/locale",
        "target": "locale",
        "include": [
          "en.json",
          "zh.json"
        ]
      },
      {
        "source": "adapters/dsh/reviewer-guard.js",
        "target": "reviewer-guard.js",
        "include": []
      }
    ]
  },
  "generated_resources": [
    {
      "host": "dsh",
      "source": "skills/review/references/reviewer-contract.md",
      "target": "reviewer-persona.json",
      "format": "json-string"
    }
  ]
}
