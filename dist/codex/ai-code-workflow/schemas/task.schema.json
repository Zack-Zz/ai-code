{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-code-workflow/task.schema.json",
  "title": "Task record structures",
  "description": "Describes the three fixed task structures implemented by scripts/workflow/state.py: create input, update input and the persisted record. The dedicated validator is authoritative.",
  "oneOf": [
    {"$ref": "#/definitions/create_input"},
    {"$ref": "#/definitions/update_input"},
    {"$ref": "#/definitions/record"}
  ],
  "definitions": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "scope", "acceptance", "change_type", "risk", "depth"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "goal": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[^/].*$"}},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "change_type": {"enum": ["feature", "bugfix", "refactor", "documentation", "configuration"]},
        "risk": {"enum": ["normal", "critical"]},
        "depth": {"enum": ["short", "standard", "architectural"]}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "status", "completed_steps", "next_action", "unresolved"],
      "properties": {
        "phase": {"enum": ["planning", "implementing", "verifying", "reviewing", "handoff"]},
        "status": {"enum": ["awaiting_confirmation", "in_progress", "blocked", "ready_for_user_review"]},
        "completed_steps": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"},
        "unresolved": {"type": "array", "items": {"$ref": "#/definitions/unresolved_item"}}
      }
    },
    "unresolved_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "severity", "completion_blocking", "evidence_ref"],
      "properties": {
        "kind": {"enum": ["confirmed_defect", "risk", "environment", "question"]},
        "summary": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low", null]},
        "completion_blocking": {"type": "boolean"},
        "evidence_ref": {"type": ["string", "null"]}
      }
    },
    "authorization_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_ref", "actions", "scope_summary"],
      "properties": {
        "message_ref": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array", "minItems": 1,
          "items": {"enum": ["plan", "implement", "run_tests", "diagnose_write", "commit", "amend", "tag", "push", "merge", "create_pr", "install", "publish"]}
        },
        "scope_summary": {"type": "string"}
      }
    },
    "create_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plan", "authorization_refs", "protected_paths"],
      "properties": {
        "schema_version": {"const": 1},
        "plan": {"$ref": "#/definitions/plan"},
        "authorization_refs": {"type": "array", "items": {"$ref": "#/definitions/authorization_ref"}},
        "protected_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "update_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": {"const": 1},
        "plan": {"$ref": "#/definitions/plan"},
        "progress": {"$ref": "#/definitions/progress"},
        "append_authorization_refs": {"type": "array", "items": {"$ref": "#/definitions/authorization_ref"}},
        "append_evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "content_sha256"],
            "properties": {
              "relative_path": {"type": "string"},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_revision", "task_id", "workspace", "baseline", "plan", "progress", "authorization_refs", "evidence_refs", "created_at", "updated_at"],
      "properties": {
        "schema_version": {"const": 1},
        "record_revision": {"type": "integer", "minimum": 1},
        "task_id": {"$ref": "#/definitions/task_id"},
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "repository_root", "git_head"],
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "repository_root": {"type": ["string", "null"]},
            "git_head": {"type": ["string", "null"]}
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dirty_files", "protected_fingerprints"],
          "properties": {
            "dirty_files": {"type": "array", "items": {"type": "string"}},
            "protected_fingerprints": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}
          }
        },
        "plan": {"$ref": "#/definitions/plan"},
        "progress": {"$ref": "#/definitions/progress"},
        "authorization_refs": {"type": "array", "items": {"$ref": "#/definitions/authorization_ref"}},
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "content_sha256"],
            "properties": {
              "relative_path": {"type": "string"},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    }
  },
  "notes": [
    "create input must not provide workspace, baseline, record_revision, created_at or updated_at; the tool computes them from the actual environment.",
    "plan.scope entries are workspace-relative paths or directory prefixes without a trailing slash; ../, absolute paths and shell expressions are rejected. scope describes the change surface, not a deletion list.",
    "A substantive plan change bumps plan.revision by one; the CLI cannot assert that new authorization_refs cover the new scope.",
    "progress.status cannot become ready_for_user_review while any unresolved item has completion_blocking=true; confirmed_defect items with severity critical/high must be completion_blocking=true.",
    "authorization_refs are an audit index only; they never prove that the referenced user messages exist or grant anything.",
    "Updates compare expected record_revision (CAS); identical content does not bump the revision."
  ]
}
